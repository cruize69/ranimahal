# ranimahal-marketing — environment variables
#
# For each var: whether its absence is LOUD (build fails, or a request
# errors clearly) or SILENT (the feature quietly no-ops/degrades).

# ── Ordering app proxy target — SILENT, falls back to production ─────
# src/lib/cateringPackages.ts hits this to fetch live catering pricing;
# defaults to https://ranimahal.food if unset, so local dev quietly talks
# to the real production ordering API unless you override it.
ORDERING_API_URL=https://ranimahal.food/api/menu

# ── Auth (Clerk) — SECONDARY, degrades gracefully ────────────────────
# Guarded by an explicit CLERK_ENABLED-style check — the site renders fine
# signed-out if this is missing.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...

# ── Blog photo inbox — LOUD (route returns 500 without it) ───────────
# api/blog-inbox-auth explicitly returns "Blog inbox is not configured"
# if this is unset — the one var in this repo that fails loud by design.
BLOG_INBOX_SECRET=

# ── Analytics — SILENT, just doesn't track ───────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
